<?xml version="1.0"?>
<sdf version="1.6">
  <world name="rescue_arena">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.18 0.25 0.35 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="main_camera">
        <pose>-4.5 -4.5 3.2 0 0.35 0.78</pose>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.3 -0.8</direction>
    </light>

    <model name="arena_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>14 14 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>14 14 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.32 0.35 0.32 1</ambient>
            <diffuse>0.38 0.40 0.36 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.05 0 0 0</pose>
    </model>

    <model name="arena_wall_north">
      <static>true</static>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>14 0.2 1.2</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>14 0.2 1.2</size></box></geometry>
          <material><ambient>0.72 0.55 0.26 1</ambient><diffuse>0.78 0.58 0.28 1</diffuse></material>
        </visual>
      </link>
      <pose>0 7 0.6 0 0 0</pose>
    </model>

    <model name="arena_wall_south">
      <static>true</static>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>14 0.2 1.2</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>14 0.2 1.2</size></box></geometry>
          <material><ambient>0.72 0.55 0.26 1</ambient><diffuse>0.78 0.58 0.28 1</diffuse></material>
        </visual>
      </link>
      <pose>0 -7 0.6 0 0 0</pose>
    </model>

    <model name="arena_wall_east">
      <static>true</static>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>0.2 14 1.2</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>0.2 14 1.2</size></box></geometry>
          <material><ambient>0.72 0.55 0.26 1</ambient><diffuse>0.78 0.58 0.28 1</diffuse></material>
        </visual>
      </link>
      <pose>7 0 0.6 0 0 0</pose>
    </model>

    <model name="arena_wall_west">
      <static>true</static>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>0.2 14 1.2</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>0.2 14 1.2</size></box></geometry>
          <material><ambient>0.72 0.55 0.26 1</ambient><diffuse>0.78 0.58 0.28 1</diffuse></material>
        </visual>
      </link>
      <pose>-7 0 0.6 0 0 0</pose>
    </model>

    <model name="crate_alpha">
      <static>true</static>
      <link name="crate_link">
        <collision name="crate_collision"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="crate_visual">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.55 0.33 0.18 1</ambient><diffuse>0.65 0.39 0.20 1</diffuse></material>
        </visual>
      </link>
      <pose>2.0 1.3 0.4 0 0 0.2</pose>
    </model>

    <model name="crate_beta">
      <static>true</static>
      <link name="crate_link">
        <collision name="crate_collision"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="crate_visual">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.28 0.42 0.55 1</ambient><diffuse>0.32 0.48 0.64 1</diffuse></material>
        </visual>
      </link>
      <pose>-2.2 -1.8 0.3 0 0 -0.3</pose>
    </model>

    <model name="barrel_one">
      <static>true</static>
      <link name="barrel_link">
        <collision name="barrel_collision"><geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="barrel_visual">
          <geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.65 0.16 0.12 1</ambient><diffuse>0.78 0.20 0.14 1</diffuse></material>
        </visual>
      </link>
      <pose>-3.2 2.4 0.4 0 0 0</pose>
    </model>

    <model name="barrel_two">
      <static>true</static>
      <link name="barrel_link">
        <collision name="barrel_collision"><geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="barrel_visual">
          <geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.15 0.42 0.23 1</ambient><diffuse>0.18 0.55 0.28 1</diffuse></material>
        </visual>
      </link>
      <pose>3.8 -2.8 0.4 0 0 0</pose>
    </model>

    <model name="rescue_ramp">
      <static>true</static>
      <link name="ramp_link">
        <collision name="ramp_collision"><geometry><box><size>2.4 1.3 0.12</size></box></geometry></collision>
        <visual name="ramp_visual">
          <geometry><box><size>2.4 1.3 0.12</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
      <!--
        Low end sits flush with the floor. At z=0.30 the 0.12 m-thick box left a
        14 cm vertical face at its entrance: taller than the 7.5 cm wheels and than
        anything on the robot's flippers, so nothing could start the climb.
      -->
      <pose>3.4 -4.3 0.156 0 -0.18 0</pose>
    </model>
  </world>
</sdf>
